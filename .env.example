# Backend
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nutrition_app
DOMAIN=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-secret

# Password reset email
# SMTP_PASS is required only when using the forgotten-password email flow.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=noreply@example.com
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Nutrition App
SMTP_PASS=

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Open Food Facts API
OFF_API_BASE_URL=https://world.openfoodfacts.org
NEXT_PUBLIC_OFF_API_BASE_URL=https://world.openfoodfacts.org

# Frontend API targets
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
